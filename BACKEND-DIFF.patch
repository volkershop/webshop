+    ['id','groupType','key','label','labelEn','enabled','sortOrder','note']
+  );
+
+  const relations = ensureSheetWithHeaders_(
+    ss,
+    SHEETS.SERVICE_FEATURES,
+    [
+      'id','gameId','gameName','serviceId','serviceName','serviceType',
+      'featureId','label','labelEn','enabled','sortOrder'
+    ]
+  );
+
+  ensureFeatureCatalogSeeds_(catalog);
+  configureAvailableFeaturesAdmin_(ss);
+  const syncResult = syncAllServiceFeatureDraftsNow();
+  moveAvailableFeatureTabs_();
