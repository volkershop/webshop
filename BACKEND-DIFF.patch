+    ['F005','resource','coins_gems','เงิน/เพชร','Coins & Gems',true,50,'บริการทรัพยากร'],
+    ['F006','resource','gems','เพชร','Gems',true,60,'บริการทรัพยากร'],
+    ['F007','resource','coins','เงิน','Coins',true,70,'บริการทรัพยากร'],
+    ['F008','resource','partial_unlocks','ปลดบางส่วน','Partial Unlocks',true,80,'บริการทรัพยากร'],
+    ['F009','zygisk','free_shop','FreeShop','Free Shop',true,10,'Zygisk Mod Menu'],
+    ['F010','zygisk','status','Status','Status',true,20,'Zygisk Mod Menu'],
+    ['F011','zygisk','all_status','All Status','All Status',true,30,'Zygisk Mod Menu'],
+    ['F012','zygisk','disable_enemy','Disable Enemy','Disable Enemy',true,40,'Zygisk Mod Menu'],
+    ['F013','zygisk','cheat_mode','Cheat Mode','Cheat Mode',true,50,'Zygisk Mod Menu'],
+    ['F014','zygisk','debug_mode','Debug Mode','Debug Mode',true,60,'Zygisk Mod Menu'],
+    ['F015','zygisk','disable_anti_cheat','Disable Anti-Cheat','Disable Anti-Cheat',true,70,'Zygisk Mod Menu'],
